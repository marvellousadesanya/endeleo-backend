# Copy to .env for local development.
NODE_ENV=development
PORT=4000

# Plain Postgres (docker compose up -d)
DATABASE_URL=postgresql://endeleo:endeleo@localhost:5434/endeleo

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32-chars-min
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-32-chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Local-disk file storage: KYC documents, data-room files, project attachments.
# NOTE: on a host with an ephemeral filesystem this is wiped on every deploy, and two
# instances cannot see each other's files. Point it at a persistent volume, or swap
# StorageService for object storage, before this carries real uploads.
STORAGE_ROOT=./storage
# Signs short-lived document download links. Generate with: openssl rand -base64 48
STORAGE_URL_SECRET=

# Shown as the account issuer in authenticator apps.
MFA_ISSUER=Endeleo

CORS_ORIGINS=http://localhost:8081
FRONTEND_URL=http://localhost:8081
PUBLIC_API_URL=http://localhost:4000

# Social sign-in. Leave blank to disable it entirely.
# Authorised redirect URI in Google Cloud: <PUBLIC_API_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Engine test controls — never set in production
BOND_ENGINE_ALLOW_SIMULATION=true
