# Copy to .env for local development.
NODE_ENV=development
PORT=4000

# Plain Postgres (docker compose up -d)
DATABASE_URL=postgresql://endeleo:endeleo@localhost:5434/endeleo

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32-chars-min
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-32-chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# File storage: KYC documents, data-room files, project attachments, bond covers.
# Cloudflare R2 (S3-compatible) — the only driver, required in every environment
# including local development. Create an API token scoped to the bucket in the R2
# dashboard; find the account ID on the R2 overview page.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL for the bucket — its r2.dev address for now, or a bound custom domain
# before this carries real production traffic (r2.dev is rate-limited).
R2_PUBLIC_URL=

# Shown as the account issuer in authenticator apps.
MFA_ISSUER=Endeleo

CORS_ORIGINS=http://localhost:8081
FRONTEND_URL=http://localhost:8081
PUBLIC_API_URL=http://localhost:4000

# Social sign-in. Leave blank to disable it entirely.
# Authorised redirect URI in Google Cloud: <PUBLIC_API_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Engine test controls — never set in production
BOND_ENGINE_ALLOW_SIMULATION=true

# Paystack — wallet top-ups. Test secret key from the Paystack dashboard (Settings ->
# API Keys & Webhooks), looks like sk_test_.... Also verifies the webhook signature —
# there is no separate webhook secret. Register the webhook URL as
# <PUBLIC_API_URL>/api/webhooks/paystack in the same dashboard page.
PAYSTACK_SECRET_KEY=

# Resend — email alerts (agreement sent/signed, checklist verified/rejected, funding
# released, team invites, wallet deposits/withdrawals, submission status changes...).
# Leave blank and the app boots fine — EmailService just logs and skips sending. Get a
# key at resend.com/api-keys. EMAIL_FROM defaults to Resend's shared onboarding@resend.dev
# sender, which needs no domain setup but is rate-limited and spam-prone — switch it to
# an address on a domain verified at resend.com/domains before this carries real traffic.
RESEND_API_KEY=
EMAIL_FROM=Endeleo <onboarding@resend.dev>

# Benchmark rate the M5 pricing screen quotes a credit spread over, in basis points
# (1800 = 18%). A manually-maintained stand-in for a live FGN yield feed — there is no
# FMDQ integration yet, so update this by hand as the benchmark moves, and treat any
# coupon it recommends as indicative until a real feed replaces it.
ARRANGEMENT_BENCHMARK_BPS=1800
