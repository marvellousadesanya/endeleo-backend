// Endeleo backend schema.
//
// NOTE FOR READERS: not everything about this database is visible here. Postgres-level
// guarantees — triggers, constraints and the atomic money procedures — live as raw SQL
// inside the migration files under prisma/migrations. Prisma does not model them, so
// `schema.prisma` alone is not the full picture of what the database enforces.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Connection URL lives in prisma.config.ts (Prisma 7).
}

enum UserStatus {
  active
  suspended
  closed

  @@map("user_status")
}

enum Role {
  admin
  editor
  issuer
  investor

  @@map("user_role")
}

enum SubmitterType {
  individual
  government
  corporate

  @@map("submitter_type")
}

enum KycStatus {
  none
  pending
  verified
  rejected

  @@map("kyc_status")
}

/// Endeleo's own identity. This id — not an auth provider's — is the domain key that
/// holdings, subscriptions and audit entries will reference.
model User {
  id       String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Always stored lowercase; normalise before writing or looking up.
  email    String     @unique
  fullName String?    @map("full_name")
  status   UserStatus @default(active)
  /// Drives what an investor is allowed to subscribe to.
  kycTier  Int        @default(0) @map("kyc_tier") @db.SmallInt

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  credential    UserCredential?
  identities    UserIdentity[]
  roles         UserRoleAssignment[]
  refreshTokens RefreshToken[]
  exchangeCodes OAuthExchangeCode[]

  issuedBonds      Bond[]                @relation("BondIssuer")
  subscriptions    Subscription[]
  holdings         Holding[]
  couponPayments   CouponPayment[]
  taxRecords       TaxRecord[]
  principalReturns PrincipalReturn[]
  listings         MarketListing[]
  soldTrades       MarketTrade[]         @relation("TradeSeller")
  boughtTrades     MarketTrade[]         @relation("TradeBuyer")
  auditEntries     BondAuditEntry[]
  profile          Profile?
  wallet           Wallet?
  walletTxs        WalletTransaction[]
  notifications    Notification[]
  investments      Investment[]
  payouts          Payout[]
  referralsMade    ReferralAttribution[] @relation("ReferralReferrer")
  referredAs       ReferralAttribution?  @relation("ReferralReferee")

  @@map("users")
}

/// Passwords, kept apart from the user record so an account can exist without one
/// (invited, or sign-in-with-provider only).
model UserCredential {
  userId       String   @id @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

/// Reserved for external identity providers. Empty today — its existence is what keeps
/// the door open to swapping provider without touching the bond registry.
model UserIdentity {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  provider  String
  subject   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
  @@map("user_identities")
}

model UserRoleAssignment {
  userId String @map("user_id") @db.Uuid
  role   Role

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

/// Refresh tokens are stored hashed and rotated on every use. `replacedBy` chains a
/// token to its successor, so a replayed token exposes the whole session family.
model RefreshToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedBy String?   @map("replaced_by") @db.Uuid
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Cooperative lock so only one instance runs a scheduled job.
///
/// A lease rather than a plain flag: if the holder crashes mid-run, the lease expires
/// and another instance picks the job up, instead of it being wedged forever.
///
/// Not a Postgres advisory lock — those are tied to a database session, and Prisma
/// hands out pooled connections, so the lock and the unlock could land on different
/// connections. A row we control has no such ambiguity.
model JobLock {
  name        String    @id
  lockedUntil DateTime  @map("locked_until") @db.Timestamptz(6)
  lockedBy    String?   @map("locked_by")
  lastRunAt   DateTime? @map("last_run_at") @db.Timestamptz(6)

  @@map("job_locks")
}

/// One-time code handed to the browser after a social sign-in.
///
/// The alternative is redirecting with the real tokens in the URL, which leaks them
/// into browser history, the Referer header and server logs. Instead the browser gets
/// a short-lived single-use code and exchanges it for tokens over POST.
model OAuthExchangeCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codeHash  String    @unique @map("code_hash")
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("oauth_exchange_codes")
}

// ─────────────────────────────────────────────────────────────────────────────
// BOND ENGINE
//
// Money is stored in minor units (kobo) as BIGINT, never as a decimal or float.
// Prisma maps these to JavaScript BigInt. Note JSON.stringify cannot serialise
// BigInt — main.ts installs a toJSON that renders them as strings, so money
// crosses the API as "2000000" rather than losing precision as a JS number.
//
// Guarantees Prisma cannot express — the status state machine, the oversell
// backstop, audit-log immutability, and the atomic allocate/trade/cancel
// procedures — are hand-written SQL inside this model's migration.
// ─────────────────────────────────────────────────────────────────────────────

enum BondStatus {
  draft
  open
  subscribed
  active
  matured
  closed
  defaulted

  @@map("bond_status")
}

enum Currency {
  NGN
  USD
  GBP
  EUR

  @@map("bond_currency")
}

enum CouponFrequency {
  monthly
  quarterly
  semiannual
  annual
  zero

  @@map("coupon_frequency")
}

enum AllocationRule {
  fcfs
  pro_rata
  waitlist

  @@map("allocation_rule")
}

enum SubscriptionStatus {
  pending
  allocated
  waitlisted
  cancelled
  refunded

  @@map("subscription_status")
}

enum PaymentStatus {
  pending
  paid
  failed
  retry
  escalated

  @@map("payment_status")
}

enum RedemptionStage {
  t_minus_90
  t_minus_30
  t_minus_7 // missing from the original engine; the spec calls for bondholder notices
  maturity
  default_declared
  archived

  @@map("redemption_stage")
}

enum EscrowPurpose {
  coupon
  principal
  default_reserve

  @@map("escrow_purpose")
}

enum ListingStatus {
  active
  filled
  cancelled
  expired

  @@map("listing_status")
}

/// A bond's term sheet and lifecycle position.
model Bond {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  isinRef      String  @unique @map("isin_ref")
  projectSlug  String? @map("project_slug")
  /// The issuer is an Endeleo user, not an auth provider's id.
  issuerId     String  @map("issuer_id") @db.Uuid
  spvReference String  @map("spv_reference")
  title        String

  currency               Currency        @default(NGN)
  totalSizeMinor         BigInt          @map("total_size_minor")
  minimumInvestmentMinor BigInt          @map("minimum_investment_minor")
  raisedMinor            BigInt          @default(0) @map("raised_minor")
  tenorMonths            Int             @map("tenor_months")
  couponRateBps          Int             @map("coupon_rate_bps")
  couponFrequency        CouponFrequency @default(quarterly) @map("coupon_frequency")
  allocationRule         AllocationRule  @default(fcfs) @map("allocation_rule")

  /// Basis points. 2000 = no investor may hold more than 20% of the bond.
  concentrationLimitBps Int      @default(2000) @map("concentration_limit_bps")
  kycTierRequired       Int      @default(1) @map("kyc_tier_required") @db.SmallInt
  geoBlock              String[] @default([]) @map("geo_block")

  subscriptionOpenAt  DateTime  @map("subscription_open_at") @db.Timestamptz(6)
  subscriptionCloseAt DateTime  @map("subscription_close_at") @db.Timestamptz(6)
  /// Both set at activation, derived from tenor when not given at issuance.
  issueDate           DateTime? @map("issue_date") @db.Date
  maturityDate        DateTime? @map("maturity_date") @db.Date

  status    BondStatus @default(draft)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  issuer           User              @relation("BondIssuer", fields: [issuerId], references: [id], onDelete: Restrict)
  subscriptions    Subscription[]
  holdings         Holding[]
  couponSchedules  CouponSchedule[]
  couponPayments   CouponPayment[]
  taxRecords       TaxRecord[]
  escrowAccounts   EscrowAccount[]
  redemptionEvents RedemptionEvent[]
  principalReturns PrincipalReturn[]
  listings         MarketListing[]
  trades           MarketTrade[]
  auditEntries     BondAuditEntry[]

  @@index([status])
  @@map("bonds")
}

/// An intent to invest, before units are handed over.
model Subscription {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bondId              String             @map("bond_id") @db.Uuid
  userId              String             @map("user_id") @db.Uuid
  amountMinor         BigInt             @map("amount_minor")
  status              SubscriptionStatus @default(pending)
  /// 48-hour cooling-off window.
  coolingOffExpiresAt DateTime           @map("cooling_off_expires_at") @db.Timestamptz(6)
  escrowReference     String?            @map("escrow_reference")
  allocatedAt         DateTime?          @map("allocated_at") @db.Timestamptz(6)
  cancelledAt         DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  bond Bond @relation(fields: [bondId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([bondId, status])
  @@index([userId])
  @@map("bond_subscriptions")
}

/// The register: who owns what. The system of record.
model Holding {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bondId          String   @map("bond_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  unitsMinor      BigInt   @map("units_minor")
  certificateHash String?  @map("certificate_hash")
  firstSettledAt  DateTime @default(now()) @map("first_settled_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  bond Bond @relation(fields: [bondId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([bondId, userId])
  @@index([userId])
  @@map("bond_holdings")
}

/// When each coupon period runs and when it is due.
model CouponSchedule {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bondId           String    @map("bond_id") @db.Uuid
  periodIndex      Int       @map("period_index")
  periodStart      DateTime  @map("period_start") @db.Date
  periodEnd        DateTime  @map("period_end") @db.Date
  scheduledPayDate DateTime  @map("scheduled_pay_date") @db.Date
  processedAt      DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  bond     Bond            @relation(fields: [bondId], references: [id], onDelete: Cascade)
  payments CouponPayment[]

  @@unique([bondId, periodIndex])
  @@index([scheduledPayDate])
  @@map("bond_coupon_schedules")
}

/// One holder's coupon for one period.
model CouponPayment {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scheduleId String @map("schedule_id") @db.Uuid
  bondId     String @map("bond_id") @db.Uuid
  userId     String @map("user_id") @db.Uuid

  /// Units × days held, the weight behind the split. Kept so a holder can be shown
  /// exactly why they were paid what they were paid.
  unitDays          BigInt @map("unit_days")
  daysHeld          Int    @map("days_held")
  closingUnitsMinor BigInt @map("closing_units_minor")
  grossMinor        BigInt @map("gross_minor")
  whtMinor          BigInt @map("wht_minor")
  netMinor          BigInt @map("net_minor")

  status      PaymentStatus @default(pending)
  /// Counts attempts, and doubles as an optimistic-concurrency version so two
  /// workers cannot pay the same coupon twice.
  attempts    Int           @default(0)
  lastError   String?       @map("last_error")
  providerRef String?       @map("provider_ref")
  paidAt      DateTime?     @map("paid_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  schedule CouponSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  bond     Bond           @relation(fields: [bondId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  tax      TaxRecord?

  @@unique([scheduleId, userId])
  @@index([status])
  @@index([userId])
  @@map("bond_coupon_payments")
}

/// Withholding tax withheld, for FIRS filing.
model TaxRecord {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bondId          String   @map("bond_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  couponPaymentId String?  @unique @map("coupon_payment_id") @db.Uuid
  taxYear         Int      @map("tax_year")
  grossMinor      BigInt   @map("gross_minor")
  whtMinor        BigInt   @map("wht_minor")
  whtRateBps      Int      @default(1000) @map("wht_rate_bps")
  currency        Currency
  recordedAt      DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  bond          Bond           @relation(fields: [bondId], references: [id], onDelete: Restrict)
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  couponPayment CouponPayment? @relation(fields: [couponPaymentId], references: [id], onDelete: SetNull)

  @@index([userId, taxYear])
  @@map("bond_tax_records")
}

/// Trustee-held funds, per bond and purpose.
model EscrowAccount {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bondId         String        @map("bond_id") @db.Uuid
  purpose        EscrowPurpose
  balanceMinor   BigInt        @default(0) @map("balance_minor")
  currency       Currency
  lastVerifiedAt DateTime?     @map("last_verified_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  bond Bond @relation(fields: [bondId], references: [id], onDelete: Restrict)

  @@unique([bondId, purpose])
  @@map("bond_escrow_accounts")
}

/// The countdown to maturity, and the default trigger at T-30.
model RedemptionEvent {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bondId       String          @map("bond_id") @db.Uuid
  stage        RedemptionStage
  scheduledFor DateTime        @map("scheduled_for") @db.Date
  executedAt   DateTime?       @map("executed_at") @db.Timestamptz(6)
  metadata     Json            @default("{}")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  bond Bond @relation(fields: [bondId], references: [id], onDelete: Restrict)

  @@unique([bondId, stage])
  @@index([scheduledFor])
  @@map("bond_redemption_events")
}

model PrincipalReturn {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bondId      String        @map("bond_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  amountMinor BigInt        @map("amount_minor")
  status      PaymentStatus @default(pending)
  attempts    Int           @default(0)
  lastError   String?       @map("last_error")
  providerRef String?       @map("provider_ref")
  paidAt      DateTime?     @map("paid_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  bond Bond @relation(fields: [bondId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([bondId, userId])
  @@map("bond_principal_returns")
}

/// Secondary market: a holder offering units for sale.
model MarketListing {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bondId      String        @map("bond_id") @db.Uuid
  sellerId    String        @map("seller_id") @db.Uuid
  unitsMinor  BigInt        @map("units_minor")
  /// Price as basis points of par. 10000 = at par.
  askPriceBps Int           @map("ask_price_bps")
  status      ListingStatus @default(active)
  expiresAt   DateTime?     @map("expires_at") @db.Timestamptz(6)
  filledAt    DateTime?     @map("filled_at") @db.Timestamptz(6)
  cancelledAt DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  bond   Bond          @relation(fields: [bondId], references: [id], onDelete: Restrict)
  seller User          @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  trades MarketTrade[]

  @@index([bondId, status])
  @@index([sellerId])
  @@map("bond_market_listings")
}

model MarketTrade {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId  String   @map("listing_id") @db.Uuid
  bondId     String   @map("bond_id") @db.Uuid
  sellerId   String   @map("seller_id") @db.Uuid
  buyerId    String   @map("buyer_id") @db.Uuid
  unitsMinor BigInt   @map("units_minor")
  priceMinor BigInt   @map("price_minor")
  feeMinor   BigInt   @map("fee_minor")
  tradeDate  DateTime @default(dbgenerated("CURRENT_DATE")) @map("trade_date") @db.Date
  executedAt DateTime @default(now()) @map("executed_at") @db.Timestamptz(6)

  listing MarketListing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  bond    Bond          @relation(fields: [bondId], references: [id], onDelete: Restrict)
  seller  User          @relation("TradeSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  buyer   User          @relation("TradeBuyer", fields: [buyerId], references: [id], onDelete: Restrict)

  @@index([bondId, executedAt])
  @@map("bond_market_trades")
}

/// Append-only record of everything that happened. A trigger blocks UPDATE and
/// DELETE outright — the previous engine relied on withholding row-level security
/// policies, which only holds while nobody connects as a privileged role.
model BondAuditEntry {
  id        BigInt   @id @default(autoincrement())
  bondId    String?  @map("bond_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  event     String
  payload   Json     @default("{}")
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)

  bond Bond? @relation(fields: [bondId], references: [id], onDelete: SetNull)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([bondId, createdAt])
  @@map("bond_audit_log")
}

/// Everything about a person that is not their identity or their credentials.
///
/// Ported from the Supabase `profiles` table, with two deliberate changes: `email` and
/// `full_name` are NOT duplicated here, because User already owns them and two copies
/// of the same fact drift. The service merges them in on read.
model Profile {
  /// Shares the User's primary key — one profile per user, always.
  userId String @id @map("user_id") @db.Uuid

  avatarUrl    String?   @map("avatar_url")
  phone        String?
  country      String?
  address      String?
  dateOfBirth  DateTime? @map("date_of_birth") @db.Date
  currencyPref String    @default("NGN") @map("currency_pref")

  /// "retail" | "institutional". Free text in Supabase; kept as text to avoid a lossy port.
  investorType  String?        @map("investor_type")
  submitterType SubmitterType? @map("submitter_type")

  companyName        String? @map("company_name")
  contactTitle       String? @map("contact_title")
  registrationNumber String? @map("registration_number")
  taxId              String? @map("tax_id")
  nationalId         String? @map("national_id")

  kycStatus      KycStatus @default(none) @map("kyc_status")
  /// Map of document key → storage path. Paths only; the files live elsewhere.
  kycDocuments   Json      @default("{}") @map("kyc_documents")
  kycSubmittedAt DateTime? @map("kyc_submitted_at") @db.Timestamptz(6)

  referralCode String? @unique @map("referral_code")
  referredBy   String? @map("referred_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// ─────────────────────────────────────────────────────────────────────────────
// WALLET, INVESTMENTS & MESSAGING
//
// Ported from Supabase. One deliberate correction throughout: money was stored
// there as `numeric`/float dollars (`balance_usd`, `amount_usd`) and added with
// JavaScript arithmetic. Here it follows the same rule as the bond engine —
// integer minor units in BIGINT, never a float — so a balance cannot drift by a
// fraction of a cent per operation.
// ─────────────────────────────────────────────────────────────────────────────

enum WalletTxKind {
  deposit
  withdrawal
  investment
  payout
  refund
  fee

  @@map("wallet_tx_kind")
}

enum WalletTxStatus {
  pending
  completed
  failed
  cancelled

  @@map("wallet_tx_status")
}

model Wallet {
  userId       String   @id @map("user_id") @db.Uuid
  /// Cents. See the note above — never a float.
  balanceMinor BigInt   @default(0) @map("balance_minor")
  currency     String   @default("USD")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model WalletTransaction {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  kind        WalletTxKind
  status      WalletTxStatus @default(completed)
  amountMinor BigInt         @map("amount_minor")
  method      String?
  reference   String?
  note        String?
  completedAt DateTime?      @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("wallet_transactions")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String
  body      String?
  href      String?
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

/// Legacy pre-bond-engine product. Kept as its own model rather than folded into
/// Subscription because the two have different lifecycles and the UI still lists them.
model Investment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  projectSlug String   @map("project_slug")
  amountMinor BigInt   @map("amount_minor")
  /// Basis points, not a float percentage — 1250 = 12.5%.
  ratePctBps  Int      @map("rate_pct_bps")
  tenorMonths Int      @map("tenor_months")
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payouts Payout[]

  @@index([userId, createdAt])
  @@map("investments")
}

model Payout {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  investmentId String   @map("investment_id") @db.Uuid
  kind         String
  amountMinor  BigInt   @map("amount_minor")
  paidAt       DateTime @map("paid_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  investment Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@index([userId, paidAt])
  @@map("payouts")
}

model ReferralAttribution {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String
  referrerId String   @map("referrer_id") @db.Uuid
  /// One attribution per referee, ever — the unique constraint is the anti-abuse rule.
  refereeId  String   @unique @map("referee_id") @db.Uuid
  status     String   @default("pending")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  referrer User @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User @relation("ReferralReferee", fields: [refereeId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@map("referral_attributions")
}
